                            </summary>
                            <div class="mt-2 p-4 bg-white rounded-2xl text-sm leading-relaxed border border-secondary">
                                <p class="mb-3">${g.info}</p>
                                <iframe width="100%" height="200" class="rounded-xl" src="https://www.openstreetmap.org/export/embed.html?bbox=${g.lng-0.01},${g.lat-0.01},${g.lng+0.01},${g.lat+0.01}&layer=mapnik&marker=${g.lat},${g.lng}"></iframe>

    <style>
        body { background-color: #f8fbfa; -webkit-tap-highlight-color: transparent; }
        .glass-card { background: rgba(255, 255, 255, 0.8); backdrop-filter: blur(8px); border: 1px solid rgba(255, 255, 255, 0.3); }
        .day-tab.active { background-color: #70aca7; color: white; transform: scale(1.05); }
        .nav-item.active { color: #70aca7; border-top: 3px solid #70aca7; }
        ::-webkit-scrollbar { width: 0px; background: transparent; }
        .scroll-hide { -ms-overflow-style: none; scrollbar-width: none; }
        .timeline-line::before { content: ''; position: absolute; left: 15px; top: 0; bottom: 0; width: 2px; background: #daefeb; }
        img[src=""] { display: none; }
    </style>
</head>
<body class="pb-24 font-sans text-gray-700">


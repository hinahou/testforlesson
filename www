        // --- Wallet Logic ---
        function convertCurrency(type) {
            const sgdInput = document.getElementById('calc-sgd');
            const twdInput = document.getElementById('calc-twd');
            if (type === 'SGD') {
                twdInput.value = (sgdInput.value * 24).toFixed(0);
            } else {
                sgdInput.value = (twdInput.value / 24).toFixed(2);
            }
        }

        let tempImageData = "";
        function handleImage(input) {
            const file = input.files[0];
            if (!file) return;

            const reader = new FileReader();
            reader.onload = function(e) {
                const img = new Image();
                img.onload = function() {
                    const canvas = document.createElement('canvas');
                    const ctx = canvas.getContext('2d');
                    const maxWidth = 200;
                    const scaleSize = maxWidth / img.width;
                    canvas.width = maxWidth;
                    canvas.height = img.height * scaleSize;
                    ctx.drawImage(img, 0, 0, canvas.width, canvas.height);
                    tempImageData = canvas.toDataURL('image/jpeg', 0.6);
                    const preview = document.getElementById('img-preview');
                    preview.src = tempImageData;
                    preview.classList.remove('hidden');
                };
                img.src = e.target.result;
            };
            reader.readAsDataURL(file);
        }

        function addExpense() {
            const name = document.getElementById('exp-name').value;
            const amt = document.getElementById('exp-amt').value;
            if (!name ||

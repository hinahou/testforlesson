        // --- View Controller ---
        function switchView(view) {
            currentView = view;
            document.querySelectorAll('.nav-item').forEach(el => el.classList.remove('active'));
            document.getElementById(`nav-${view}`).classList.add('active');
            renderApp();
        }

        function setDay(day) {
            currentDay = day;
            renderDayTabs();
            renderApp();
        }

        // --- Renderers ---
        function renderDayTabs() {
            const container = document.getElementById('day-tabs');
            container.innerHTML = ITINERARY_DATA.map(d => `
                <button onclick="setDay(${d.day})" class="day-tab px-5 py-2 rounded-2xl whitespace-nowrap text-sm font-bold transition-all ${currentDay === d.day ? 'active shadow-md' : 'bg-white/30'}">
                    Day ${d.day}
